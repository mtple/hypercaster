# Hypercast build settings. Copy to .env.local and edit.
# These are read when the app is built, and end up in the public bundle:
# never put a secret here. Hypercast has none.

# The Hypersnap node to read from. An https:// origin, or a same-origin path
# (for example /hs) when a proxy in front of the node is used.
VITE_HYPERSNAP_URL=https://haatz.quilibrium.com

# Name shown in the interface.
VITE_APP_NAME=Hypercast

# Leave unset for a read-only build. Only the exact value "true" includes
# signing in and posting. Read docs/WRITES.md before turning this on.
# VITE_ENABLE_WRITES=true
